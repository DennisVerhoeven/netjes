# Copy to .env (gitignored) and change the password for anything but local development.
POSTGRES_DB=taskboard
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=change-me

# Production (compose.prod.yaml): the site Caddy serves over https, e.g. taskboard.example.com (localhost by default).
TASKBOARD_SITE=localhost
# The network between Caddy and the app, and Caddy's address on it; the app trusts X-Forwarded-* from that address only.
TASKBOARD_EDGE_SUBNET=172.30.250.0/29
TASKBOARD_PROXY_ADDRESS=172.30.250.2
